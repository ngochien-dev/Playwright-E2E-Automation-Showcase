{
  "name": "autotest-showcase",
  "version": "1.0.0",
  "description": "Premium Web Automation Testing Showcase with Playwright & TypeScript",
  "main": "app/server.js",
  "scripts": {
    "start:app": "node app/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --headed",
    "test:report": "playwright show-report",
    "allure:generate": "node allure-setup.js && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "docker:build": "docker build -t autotest-app .",
    "docker:up": "docker-compose up"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "multer": "^2.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/sqlite3": "^3.1.11",
    "allure-commandline": "^2.41.0",
    "allure-playwright": "^3.9.0",
    "typescript": "^5.4.5"
  }
}
